# LOCAL_ONLY_MODE=true skips the first-run name screen for local debugging
# (silent local_dev). Production still uses FirstRunNameScreen, then local_dev.
LOCAL_ONLY_MODE=false

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Free tier: enable only "Maps SDK for Android" in Google Cloud (not Directions API).
# Bot secrets are NOT embedded into debug or release APKs by default.
# For on-device Telegram debugging only:  ./gradlew :app:assembleDebug -PallowDebugSecrets=true
TELEGRAM_BOT_TOKEN=

# Optional Google Drive backup (Settings → Google Drive): enable Drive API and
# register an Android OAuth client (package com.truckorig + signing SHA-1).
GOOGLE_ANDROID_CLIENT_ID=253720408597-8pp7kbk23mblnfuj2nk687e20n88ftl7.apps.googleusercontent.com
# API key restricted to Drive API + Android app com.truckorig. Sent with Drive REST calls.
GOOGLE_DRIVE_API_KEY=AIzaSyDCX5BKeyxFyLYZ7J5LKPkEAAt4GvBELPw

# Do not run another long-poll/webhook with the same TELEGRAM_BOT_TOKEN —
# Telegram delivers updates to only one client.
