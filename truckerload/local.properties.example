# Copy to local.properties and fill in your keys
# sdk.dir is auto-added by Android Studio
#
# LOCAL_ONLY_MODE=true only disables cloud workers / Supabase client.
# It no longer skips the login screen — entry is always Google Auth on Android.
LOCAL_ONLY_MODE=false

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Debug builds only: these are wiped from release BuildConfig (enter token in Settings).
CEREBRAS_API_KEY=
TELEGRAM_BOT_TOKEN=

# Cloud snapshot/inbox API. Production URLs must use HTTPS.
SYNC_BACKEND_URL=
# Durable photo/scan upload and cross-device hydration. Disabled unless explicitly true;
# also requires SYNC_BACKEND_URL, LOCAL_ONLY_MODE=false, and an authenticated JWT session.
CLOUD_MEDIA_ENABLED=false
# device = local foreground Telegram bot; server = authenticated backend inbox.
TELEGRAM_SYNC_MODE=device
# Non-secret username used to build https://t.me/<bot>?start=<link-token>.
TELEGRAM_SERVER_BOT_USERNAME=

# Google OAuth — Web для Supabase signInWithIdToken, Android для OAuth Client в Console
GOOGLE_WEB_CLIENT_ID=842861516910-gkhu4dh9tu5rc8re40rpe4583hvs4uhv.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=842861516910-usd22msidljtngc00p2jeokn6qf5te94.apps.googleusercontent.com

# Supabase — опционально. Пусто = Google-аккаунт только на устройстве.
# Нужен для общего аккаунта между устройствами / friends live sync.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: apply cloud SQL from CI/agent (never commit real values)
# SUPABASE_DB_URL=postgresql://postgres.…@db.<ref>.supabase.co:5432/postgres
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=jsptulbjtesnphrbxsil

# Google Drive backup (Settings → Google Drive): enable Drive API in Google Cloud
# for the same project as GOOGLE_WEB_CLIENT_ID / Android OAuth client.

# Не запускайте другой long-poll/webhook с тем же TELEGRAM_BOT_TOKEN —
# Telegram отдаёт апдейты только одному клиенту.
