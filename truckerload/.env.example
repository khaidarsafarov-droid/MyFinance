# Copy to .env and replace every change-me value. Never commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/truckerload
DATABASE_USER=truckerload
DATABASE_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET=truckerload-media

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=change-me-at-least-32-characters
SUPABASE_JWT_AUDIENCE=authenticated
TELEGRAM_WEBHOOK_SECRET=change-me-at-least-16-characters

PUBLIC_BASE_URL=http://localhost:8080
LOCAL_STORAGE_SIGNING_SECRET=change-me-at-least-32-characters
STORAGE_KIND=local
LOCAL_STORAGE_PATH=./data/media
MAX_UPLOAD_BYTES=26214400
UPLOAD_EXPIRY_SECONDS=900
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600

# Optional. Firebase Admin uses application default credentials when this is set.
FIREBASE_PROJECT_ID=
