{
  "$schema": "https://truckerload.local/design-tokens.schema.json",
  "name": "Truck Log — Mindwell Forest",
  "source": "SoftUiTheme.kt / Gemini Truck Log prototype",
  "version": "1.1.0",
  "colors": {
    "forestPrimary": "#2F4F3E",
    "forestAccent": "#4A7C59",
    "forestMuted": "#557A64",
    "forestSoft": "#A3B899",
    "sage": "#E6EDE9",
    "sageHover": "#D2E0D7",
    "sageBorder": "#D2E0D7",
    "sageBorderStrong": "#C5D3C9",
    "cardBorder": "#E1EAE4",
    "contentBg": "#F9FBFA",
    "shellBg": "#F2F7F4",
    "outerBg": "#D8E2DC",
    "surface": "#FFFFFF",
    "onPrimary": "#FFFFFF",
    "backgroundDark": "#1A2420",
    "surfaceDark": "#24302A",
    "surfaceMutedDark": "#2E3C35",
    "textPrimaryDark": "#F2F7F4",
    "textSecondaryDark": "#A3B899",
    "rpmGreen": "#34D399",
    "rpmYellow": "#FFD54F",
    "rpmRed": "#FF8A80"
  },
  "radii": {
    "chip": 16,
    "button": 16,
    "card": 24,
    "phone": 40
  },
  "elevation": {
    "card": 2,
    "button": 4,
    "fab": 8,
    "nav": 0
  },
  "typography": {
    "fontFamily": "DM Sans",
    "androidFonts": [
      "dm_sans_regular",
      "dm_sans_medium",
      "dm_sans_semibold",
      "dm_sans_bold"
    ],
    "brandTracking": "0.12em",
    "tabularFigures": true
  },
  "navigation": {
    "phoneTabs": ["logbook", "weeklyGoal", "community", "profile"]
  },
  "widget": {
    "light": {
      "bg": "#2F4F3E",
      "bgBottom": "#4A7C59"
    },
    "dark": {
      "bg": "#1A2420",
      "bgBottom": "#24302A"
    }
  },
  "screens": [
    "home",
    "goal",
    "add-load",
    "community",
    "profile",
    "settings",
    "login"
  ]
}
