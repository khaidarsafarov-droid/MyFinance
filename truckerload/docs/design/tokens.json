{
  "$schema": "https://truckerload.local/design-tokens.schema.json",
  "name": "Truck Log — Mindwell Forest",
  "source": "SoftUiTheme.kt / SemanticColors.kt",
  "version": "1.2.0",
  "colors": {
    "forestPrimary": "#2F4F3E",
    "forestAccent": "#4A7C59",
    "forestMuted": "#557A64",
    "forestSoft": "#A3B899",
    "sage": "#E6EDE9",
    "sageHover": "#D2E0D7",
    "sageBorder": "#D2E0D7",
    "sageBorderStrong": "#C5D3C9",
    "cardBorder": "#E1EAE4",
    "contentBg": "#F6F6F6",
    "shellBg": "#EEEEEE",
    "outerBg": "#E4E4E4",
    "surface": "#FFFFFF",
    "onPrimary": "#FFFFFF",
    "textSecondaryLight": "#3A5748",
    "backgroundDark": "#1A2420",
    "surfaceDark": "#24302A",
    "surfaceMutedDark": "#2E3C35",
    "forestAccentDark": "#8ED4A4",
    "onForestAccentDark": "#0F1A14",
    "textPrimaryDark": "#F2F7F4",
    "textSecondaryDark": "#C5D3C9"
  },
  "semantic": {
    "light": {
      "success": "#176B3A",
      "warning": "#8A5800",
      "danger": "#B42318",
      "neutral": "#3A5748",
      "hero": "#2F4F3E"
    },
    "dark": {
      "success": "#5EE0A0",
      "warning": "#F5C84C",
      "danger": "#FF8B80",
      "neutral": "#C5D3C9",
      "hero": "#F2F7F4"
    }
  },
  "radii": {
    "chip": 16,
    "button": 16,
    "card": 24,
    "phone": 40
  },
  "elevation": {
    "card": 2,
    "button": 4,
    "fab": 8,
    "nav": 0
  },
  "typography": {
    "fontFamily": "DM Sans",
    "androidFonts": [
      "dm_sans_regular",
      "dm_sans_medium",
      "dm_sans_semibold",
      "dm_sans_bold"
    ],
    "brandTracking": "0.12em",
    "tabularFigures": true,
    "heroNumber": {
      "sizeSp": 40,
      "weight": "Bold",
      "fontFeatureSettings": "tnum"
    }
  },
  "navigation": {
    "phoneTabs": ["logbook", "weeklyGoal", "community", "profile"]
  },
  "widget": {
    "light": {
      "bg": "#F6F6F6",
      "textPrimary": "#2F4F3E",
      "textSecondary": "#3A5748"
    },
    "dark": {
      "bg": "#1A2420",
      "textPrimary": "#F2F7F4",
      "textSecondary": "#C5D3C9"
    }
  },
  "screens": [
    "home",
    "goal",
    "add-load",
    "community",
    "profile",
    "settings",
    "login"
  ]
}
