<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1">

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_action_chip" />

        <ImageView
            android:id="@+id/widget_btn_scanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_scanner"
            android:scaleType="center"
            android:src="@drawable/ic_widget_scanner" />
    </FrameLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:background="@color/widget_divider" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1">

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_action_chip" />

        <ImageView
            android:id="@+id/widget_btn_camera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_camera"
            android:scaleType="center"
            android:src="@drawable/ic_widget_camera" />
    </FrameLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:background="@color/widget_divider" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1">

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_action_chip" />

        <ImageView
            android:id="@+id/widget_btn_diesel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_diesel"
            android:scaleType="center"
            android:src="@drawable/ic_widget_diesel" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_btn_scanner_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_btn_camera_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_btn_diesel_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
