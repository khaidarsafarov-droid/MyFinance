<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_btn_scanner"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_scanner"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_scanner" />

    <ImageView
        android:id="@+id/widget_btn_camera"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_camera"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_camera" />

    <ImageView
        android:id="@+id/widget_btn_diesel"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_diesel"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_diesel" />

    <TextView
        android:id="@+id/widget_btn_scanner_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_btn_camera_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_btn_diesel_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
