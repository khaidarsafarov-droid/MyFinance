<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_outer"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/widget_padding_compact">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_brand_title_plain"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_gross_hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_amount_compact"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_hero_section"
        android:layout_width="@dimen/widget_circle_compact"
        android:layout_height="@dimen/widget_circle_compact"
        android:layout_marginStart="@dimen/widget_spacing_compact">

        <ImageView
            android:id="@+id/widget_progress_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_ring_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/widget_text_hint"
            android:textSize="@dimen/widget_percent_compact" />

        <TextView
            android:id="@+id/widget_goal_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_day_dots_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_spacing_compact"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_day_0"
            android:layout_width="@dimen/widget_day_indicator_size_compact"
            android:layout_height="@dimen/widget_day_indicator_size_compact"
            android:contentDescription="@null"
            android:src="@drawable/widget_day_future" />

        <ImageView
            android:id="@+id/widget_day_1"
            android:layout_width="@dimen/widget_day_indicator_size_compact"
            android:layout_height="@dimen/widget_day_indicator_size_compact"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_day_future" />

        <ImageView
            android:id="@+id/widget_day_2"
            android:layout_width="@dimen/widget_day_indicator_size_compact"
            android:layout_height="@dimen/widget_day_indicator_size_compact"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_day_future" />

        <ImageView
            android:id="@+id/widget_day_3"
            android:layout_width="@dimen/widget_day_indicator_size_compact"
            android:layout_height="@dimen/widget_day_indicator_size_compact"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_day_future" />

        <ImageView
            android:id="@+id/widget_day_4"
            android:layout_width="@dimen/widget_day_indicator_size_compact"
            android:layout_height="@dimen/widget_day_indicator_size_compact"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_day_future" />

        <ImageView
            android:id="@+id/widget_day_5"
            android:layout_width="@dimen/widget_day_indicator_size_compact"
            android:layout_height="@dimen/widget_day_indicator_size_compact"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_day_future" />

        <ImageView
            android:id="@+id/widget_day_6"
            android:layout_width="@dimen/widget_day_indicator_size_compact"
            android:layout_height="@dimen/widget_day_indicator_size_compact"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_day_future" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_right_column"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content_section"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_week_days"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_rpm_divider"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_rpm_label"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_rpm_value"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
            android:id="@+id/widget_details_row"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_need_per_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_to_go"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_empty_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
