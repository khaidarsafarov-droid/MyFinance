<?xml version="1.0" encoding="utf-8"?>
<!-- SoftUI lavender plate with subtle brand depth. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_bg_bottom"
        android:startColor="@color/widget_bg"
        android:type="linear" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_bg_stroke" />
</shape>
