<?xml version="1.0" encoding="utf-8"?>
<!-- Always-dark brand-blue cabin plate (matches TruckoRig shield logo). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#FF0F2A5C"
        android:startColor="#FF143882"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1.5dp"
        android:color="#66A8D4F0" />
</shape>
