<?xml version="1.0" encoding="utf-8"?>
<!-- Always-dark cabin plate for the budget ring widget (matches the classic home-screen look). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#FF24302A"
        android:startColor="#FF1A2420"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
