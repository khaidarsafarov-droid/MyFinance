<?xml version="1.0" encoding="utf-8"?>
<!-- App Actions live here (shortcuts.xml). actions.xml is deprecated and must not be added.
     Fulfillment always launches MainActivity; there is no background / spoken-only path. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/open{?featureName}" />
            <parameter
                android:name="feature"
                android:key="featureName" />
        </intent>
    </capability>

    <capability android:name="actions.intent.GET_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/search{?q}" />
            <parameter
                android:name="thing.name"
                android:key="q" />
        </intent>
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/search" />
        </intent>
    </capability>

    <capability
        android:name="custom.actions.intent.ADD_DIESEL"
        app:queryPatterns="@array/assistant_queries_add_diesel">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/add_diesel{?amount,gallons,date}" />
            <parameter
                android:name="amount"
                android:key="amount"
                android:mimeType="https://schema.org/Number"
                android:required="true" />
            <parameter
                android:name="gallons"
                android:key="gallons"
                android:mimeType="https://schema.org/Number" />
            <parameter
                android:name="date"
                android:key="date"
                android:mimeType="https://schema.org/Date" />
        </intent>
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/add_diesel" />
        </intent>
    </capability>

    <capability
        android:name="custom.actions.intent.ADD_PAYCHECK"
        app:queryPatterns="@array/assistant_queries_add_paycheck">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/add_paycheck{?amount,weekNumber,year}" />
            <parameter
                android:name="amount"
                android:key="amount"
                android:mimeType="https://schema.org/Number"
                android:required="true" />
            <parameter
                android:name="weekNumber"
                android:key="weekNumber"
                android:mimeType="https://schema.org/Number" />
            <parameter
                android:name="year"
                android:key="year"
                android:mimeType="https://schema.org/Number" />
        </intent>
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/add_paycheck" />
        </intent>
    </capability>

    <capability
        android:name="custom.actions.intent.QUERY_WEEKLY_GROSS"
        app:queryPatterns="@array/assistant_queries_weekly_gross">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/weekly_gross{?weekNumber,year}" />
            <parameter
                android:name="weekNumber"
                android:key="weekNumber"
                android:mimeType="https://schema.org/Number" />
            <parameter
                android:name="year"
                android:key="year"
                android:mimeType="https://schema.org/Number" />
        </intent>
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/weekly_gross" />
        </intent>
    </capability>

    <capability android:name="actions.intent.GET_MESSAGE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/chat{?recipientName}" />
            <parameter
                android:name="message.recipient.name"
                android:key="recipientName" />
        </intent>
    </capability>

    <capability android:name="actions.intent.CREATE_MESSAGE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/message{?recipientName,messageText}" />
            <parameter
                android:name="message.recipient.name"
                android:key="recipientName" />
            <parameter
                android:name="message.text"
                android:key="messageText" />
        </intent>
    </capability>

    <capability android:name="actions.intent.CREATE_CALL">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity">
            <url-template android:value="truckerload://assistant/call{?calleeName}" />
            <parameter
                android:name="call.callee.name"
                android:key="calleeName" />
        </intent>
    </capability>

    <shortcut
        android:shortcutId="add_load"
        android:shortcutShortLabel="@string/add_load_title"
        android:shortcutLongLabel="@string/add_load_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="truckerload://app/add_load"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/voice_feature_add_load" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="add_diesel"
        android:shortcutShortLabel="@string/add_diesel_title"
        android:shortcutLongLabel="@string/add_diesel_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="truckerload://assistant/add_diesel"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/voice_feature_add_diesel" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="add_paycheck"
        android:shortcutShortLabel="@string/add_paycheck_title"
        android:shortcutLongLabel="@string/add_paycheck_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="truckerload://assistant/add_paycheck"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/voice_feature_add_paycheck" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="weekly_gross"
        android:shortcutShortLabel="@string/voice_journal_gross_title"
        android:shortcutLongLabel="@string/voice_journal_gross_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="truckerload://assistant/weekly_gross"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/voice_feature_weekly_gross" />
        </capability-binding>
        <capability-binding android:key="actions.intent.GET_THING">
            <parameter-binding
                android:key="thing.name"
                android:value="@array/voice_feature_weekly_gross" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="weekly_goal"
        android:shortcutShortLabel="@string/nav_weekly_goal"
        android:shortcutLongLabel="@string/nav_weekly_goal">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="truckerload://app/stats"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/voice_feature_weekly_goal" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="community"
        android:shortcutShortLabel="@string/nav_community"
        android:shortcutLongLabel="@string/nav_community">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="truckerload://app/community"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/voice_feature_community" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="friends_map"
        android:shortcutShortLabel="@string/drawer_friends_live"
        android:shortcutLongLabel="@string/friends_live_map_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="truckerload://app/friends_live"
            android:targetPackage="com.truckerload"
            android:targetClass="com.truckerload.presentation.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/voice_feature_friends" />
        </capability-binding>
    </shortcut>
</shortcuts>
