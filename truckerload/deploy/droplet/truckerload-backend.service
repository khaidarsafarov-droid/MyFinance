[Unit]
Description=TruckerLoad Ktor API
After=network-online.target postgresql.service livekit.service
Wants=network-online.target

[Service]
Type=simple
User=truckerload
Group=truckerload
EnvironmentFile=/etc/truckerload/backend.env
WorkingDirectory=/opt/truckerload
ExecStart=/opt/truckerload/bin/server
Restart=always
RestartSec=3
LimitNOFILE=65535
MemoryMax=280M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
