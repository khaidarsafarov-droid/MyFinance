# Copy to debug-keystore.properties (gitignored) for a permanent debug signing key.
# PKCS12: storePassword and keyPassword MUST be identical.
#
#   mkdir -p signing
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore signing/truckerload-debug.keystore \
#     -alias androiddebugkey \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass 'YOUR_DEBUG_PASS' -keypass 'YOUR_DEBUG_PASS' \
#     -dname 'CN=Android Debug, OU=TruckerLoad, O=TruckerLoad, C=US'
#
storeFile=signing/truckerload-debug.keystore
storePassword=YOUR_DEBUG_PASS
keyAlias=androiddebugkey
keyPassword=YOUR_DEBUG_PASS
