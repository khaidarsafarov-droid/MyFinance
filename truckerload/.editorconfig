root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ktlint_code_style = intellij_idea
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview, PreviewLightDark, PreviewFontScale, PreviewScreenSizes, PreviewParameter
max_line_length = 140
