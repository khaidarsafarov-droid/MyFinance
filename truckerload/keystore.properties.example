# Copy to keystore.properties (gitignored) and fill real values.
# Generate a keystore once and keep it — Play Store updates must use the same upload key.
#
# PKCS12: storePassword and keyPassword MUST be identical (keytool ignores -keypass).
#
#   mkdir -p signing
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore signing/truckerload-friends.keystore \
#     -alias truckerload \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass 'YOUR_STORE_PASS' -keypass 'YOUR_STORE_PASS' \
#     -dname 'CN=TruckoRig, OU=Play, O=TruckoRig, C=US'
#
# Keep the existing file name if this keystore already signed previous APKs.
storeFile=signing/truckerload-friends.keystore
storePassword=YOUR_STORE_PASS
keyAlias=truckerload
keyPassword=YOUR_STORE_PASS
