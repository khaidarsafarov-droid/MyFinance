# Server
PORT=3000
SERVER_URL=https://your-server.com

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/truckerload

# Telegram Bot API
BOT_TOKEN=your_bot_token

# Telegram MTProto (for history analysis)
TG_API_ID=12345
TG_API_HASH=abcdef123456
TG_SESSION=your_saved_session_string

# AI: Cerebras (first) + Gemini (fallback).
# App + (Cerebras + Gemini) + Bot
CEREBRAS_API_KEY=your_cerebras_key
GEMINI_API_KEY=your_gemini_key

# Firebase (FCM)
FIREBASE_PROJECT_ID=your_project
FIREBASE_PRIVATE_KEY=your_key
FIREBASE_CLIENT_EMAIL=your_email

# Redis (Bull queue)
REDIS_URL=redis://localhost:6379
